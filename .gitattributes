# This repository targets Windows only (Native Messaging hosts write to the
# Windows registry, .bat launcher scripts, PowerShell as the primary shell)
# — line endings are pinned here rather than left to each contributor's
# local core.autocrlf setting, so checkouts stay consistent regardless of
# that config.
* text=auto eol=crlf

# Batch scripts must stay CRLF even if the default above ever changes —
# cmd.exe's handling of bare-LF batch files is inconsistent.
*.bat text eol=crlf
*.cmd text eol=crlf

# Machine-generated lockfiles: normal text handling, but excluded from
# diffs (content is regenerated by the package manager, not hand-edited)
# and from GitHub's language statistics.
package-lock.json text -diff linguist-generated=true
Cargo.lock text -diff linguist-generated=true

# Binary assets: no line-ending conversion, no text diff attempted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
